# Gateway
PORT=4000
NODE_ENV=development

# Signing key for session tokens (HMAC). Rotate per environment; never commit a real value.
AUTH_TOKEN_SECRET=dev-only-change-me
AUTH_TOKEN_TTL_SECONDS=3600
# Single-use passcode reset tokens (INSTRUCTIONS.md §8)
RESET_TOKEN_TTL_SECONDS=900

# Dev-only credential-free login (POST /auth/dev-login). Hard-gated: the route
# only registers when NODE_ENV != production AND this is "true". Never set
# ALLOW_DEV_AUTH=true in a production environment.
ALLOW_DEV_AUTH=false

# Comma-separated emails that resolve to the admin role on any identity path
# (dev-login, Google OAuth). Never trust a role from the client or provider —
# this list is the only source of truth. Case-insensitive.
ADMIN_EMAIL_ALLOWLIST=

# Google OAuth (arctic) — GET /auth/google/start, GET /auth/google/callback.
# Leave blank until real credentials exist; the routes are always registered,
# but /start won't produce a usable consent screen without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Lifetime of the state/PKCE cookies set by /auth/google/start.
OAUTH_STATE_TTL_SECONDS=600
# Where the web app runs. GET /auth/google/callback redirects the browser here
# (to /auth/callback, with the token in the URL fragment) once it lands back
# from Google — the gateway origin is not somewhere a candidate should see a
# raw JSON response.
FRONTEND_URL=http://localhost:3000

# Postgres — durable session/candidate/report records
DATABASE_URL=postgres://mia:mia@localhost:5432/mia

# Redis — live session state + timers
REDIS_URL=redis://localhost:6379

# Set to "memory" to run the gateway with in-memory stores (no Postgres/Redis needed).
# Used by the test suite and by `npm run dev` before infra is up.
STORAGE_DRIVER=memory

# Uploaded resumes (disk file store, used when STORAGE_DRIVER=postgres).
# Deleting a resume removes the bytes here, not just the database pointer.
UPLOAD_DIR=uploads
MAX_RESUME_BYTES=5242880
# Largest recorded answer accepted, decoded. Enforced identically on
# POST /sessions/:id/answers/audio and on the live WebSocket channel.
MAX_AUDIO_BYTES=20971520

# --- Speech ------------------------------------------------------------
# TTS: the sherpa-onnx VITS voice. Point this at the directory holding the
# downloaded model (see RUN_GUIDE.md). Absent, questions fall back to text.
SPEECH_MODEL_DIR=models

# STT: faster-whisper. NOT sherpa-onnx — the two halves of the Speech Service
# have independent runtimes and either can be missing without taking the other
# down.
#
# `tiny.en` is English-only, ~75MB, and fast enough on CPU to stay inside the
# latency budget in INSTRUCTIONS.md §9. Fetched once into the HuggingFace cache
# and used offline after that; set STT_MODEL_DIR to a vendored CTranslate2
# directory instead for a deployment with no network at all.
STT_MODEL=tiny.en
STT_COMPUTE_TYPE=int8
# STT_MODEL_DIR=models/faster-whisper-tiny.en

# Hard wall-clock cap on one transcription, in seconds. This bounds an
# UNBOUNDED failure rather than describing expected latency: fed noise, a
# Whisper decoder can loop emitting repeated tokens indefinitely. On expiry the
# candidate is offered the typed fallback, so a timeout costs a retype and
# never the answer.
STT_TIMEOUT_SECONDS=15

# Silero VAD inside the decode, on top of the energy gate that runs before the
# model reaches it. Leave on: without it, Whisper answers silence with a
# confident invented word. Set false only to see what the raw decoder heard.
STT_VAD_FILTER=true

# Web app (apps/web) — where the browser reaches the gateway.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# Per-session MCP rate limit (calls per window).
#
# One interview turn is several MCP calls — memory, question, timer, speech,
# eval, follow-up — so a candidate answering briskly makes far more than 60 in
# ten seconds. This file shipped 60 while the code default was 300, and nothing
# loaded `.env` at all, so the mismatch went unnoticed until the loader was
# fixed: with 60, a real session starts returning 429 around the fifth
# question. Keep this in step with `mcpRateLimit` in apps/gateway/src/config.ts.
MCP_RATE_LIMIT=300
MCP_RATE_LIMIT_WINDOW_MS=10000

# =============================================================================
# Stage 5 — LLM provider (INSTRUCTIONS.md §5.7, §11.5)
# =============================================================================
#
# THIRD-PARTY DATA SHARING — READ THIS BEFORE SETTING A KEY BELOW.
#
# soul.md §"Privacy by default" says candidate data is not shared with third
# parties. The LLM Provider Tool is the one documented, named exception: the
# Resume Service, Question and Follow-up Question Agents send resume text, job
# description text and answer transcripts to whichever provider is configured
# here. Documenting each provider's data-use and retention terms in this file is
# a requirement of §8, not a suggestion, and it applies whichever provider is
# active. Verify these against the provider's CURRENT terms rather than trusting
# the summary below — they change, and this comment does not update itself.
#
# Unset, or set to a provider whose credentials are missing, the system falls
# back to a deterministic in-process fixture and NO candidate text leaves the
# box. That is the default, and it is a safe one.
#
# groq       — the Stage 5 default. Model openai/gpt-oss-120b on Groq's LPU
#              inference, chosen for latency during interactive generation.
#              As of Stage 5: Groq's terms state API inputs/outputs are not used
#              to train models; retention is limited to what is needed to serve
#              and secure the request. Verify at https://groq.com/terms-of-use/
#              and their privacy policy before enabling in production.
# bedrock    — AWS Bedrock. Standard terms state customer inputs/outputs are not
#              used to train the underlying models and are not shared with model
#              providers. Data stays in the configured AWS region. This is the
#              strongest default of the three on paper; verify against AWS's
#              current documentation rather than assuming.
# openrouter — a genuinely free alternate for LOCAL TESTING. Its data-use terms
#              vary by which backing host serves a given request and are not
#              uniformly documented, which is exactly why it is not recommended
#              for real candidate data. Prefer it only with synthetic fixtures.
# ollama     — Ollama Cloud (gemma4:31b-cloud by default; OLLAMA_MODEL overrides).
#              Used for resume/JD parsing extraction. Ollama's cloud terms are
#              not as uniformly documented as Groq's or AWS's — verify at
#              https://ollama.com/ before enabling for real candidate data, the
#              same way you would for openrouter.
# fixture    — deterministic, in-process, no network. No third party involved.
LLM_PROVIDER=fixture

# Per-role overrides (packages/llm-client/src/provider.ts, ROLE_ENV_VAR).
# Each takes any value LLM_PROVIDER does (including "fixture"); blank falls
# back to LLM_PROVIDER above. Lets a deployment put question generation on
# one provider (e.g. Groq, for latency) and resume/JD parsing on another
# (e.g. Ollama) without either agent's own code naming a provider (§11.5).
# tool-resume-parser's LLM extraction shares RESUME_SERVICE_LLM_PROVIDER —
# it is the same resume/JD-parsing capability as resume-service-agent, split
# into a separate MCP server for architectural reasons (§5.1), not a
# separately-configurable one. Follow-up has no role-specific override yet
# and always follows LLM_PROVIDER.
QUESTION_AGENT_LLM_PROVIDER=
RESUME_SERVICE_LLM_PROVIDER=

# groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# bedrock — credentials come from the standard AWS provider chain, not from here
AWS_REGION=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# ollama — defaults to a LOCAL Ollama daemon (http://localhost:11434/v1) with
# no key required. For Ollama Cloud, set OLLAMA_BASE_URL=https://ollama.com/v1
# and OLLAMA_API_KEY to a cloud API key.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:31b-cloud

# -----------------------------------------------------------------------------
# LangSmith tracing (INSTRUCTIONS.md §8, soul.md §"Privacy by default")
# -----------------------------------------------------------------------------
#
# LangSmith is a SECOND, INDEPENDENT third-party recipient of candidate text —
# not a detail of the provider choice above. A traced run carries the same
# resume, job description and transcript content the generation call carried, to
# a different company, under different terms. As of Stage 5: LangSmith retains
# trace data per your workspace's configured retention period and does not use
# it to train models; verify at https://www.langchain.com/ before enabling.
#
# It is OFF unless NODE_ENV=development AND LANGSMITH_OPT_IN=true AND an API key
# is present. The gate actively CLEARS LANGCHAIN_TRACING_V2 / LANGSMITH_TRACING
# when those do not all hold, so a value inherited from a shell profile or a base
# container image cannot quietly turn it on. Enabling it for staging or
# production needs the same documentation here and, ideally, LangSmith's own
# PII-redaction options rather than raw candidate text.
LANGSMITH_OPT_IN=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mock-interview-ai

# =============================================================================
# Stage 5 — session archive store (INSTRUCTIONS.md §11.4, §11.6, §8)
# =============================================================================
#
# A SEPARATE Supabase-hosted Postgres instance. It must NOT be the same database
# as DATABASE_URL above: the archive is an export copy for Admin download, and
# putting it inside the database the retention job prunes would defeat the point
# of having one.
#
# Use the service-role / direct connection string. It is read server-side only
# and never reaches a browser — Supabase's own auth and RLS are NOT the access
# boundary for this data, the gateway's admin RBAC is (§8). Leave blank to run
# without archiving; sessions then complete exactly as they did at Stage 4.
#
# Apply its schema with `npm run db:migrate:archive` (a separate command from
# `npm run db:migrate`, so neither can touch the other's database).
SUPABASE_DB_URL=
