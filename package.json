{
  "name": "mock-interview-ai",
  "private": true,
  "version": "0.1.0",
  "description": "AI mock interview platform — multi-agent architecture routed through MCP",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "agents/*",
    "mcp-servers/*"
  ],
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --port 4000",
    "dev:web": "npm run dev --workspace @mia/web",
    "build:web": "npm run build --workspace @mia/web",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace @mia/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "lint": "tsc -p tsconfig.json && npm run lint:agents",
    "lint:agents": "tsx packages/agent-lint/src/cli.ts",
    "check:llm": "tsx scripts/check-llm.ts",
    "db:migrate": "cd backend && .venv\\Scripts\\python.exe -m app.storage.migrate",
    "db:migrate:archive": "cd backend && .venv\\Scripts\\python.exe -m app.storage.migrate --archive",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "dev:ts-frozen": "npm run dev --workspace @mia/gateway",
    "db:migrate:ts-frozen": "npm run db:migrate --workspace @mia/gateway",
    "db:migrate:archive:ts-frozen": "npm run db:migrate:archive --workspace @mia/gateway"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
